# Oxyflame (mobile PWA) — production config.
# NOT a secret: this value is baked into the public JavaScript at build time.
# Set it to your deployed worker URL from `pnpm run deploy` (no trailing slash),
# then build/deploy with `pnpm deploy:app`. Only the Ask chat uses it; everything
# else runs offline from the bundled dataset.
VITE_API_BASE=https://oxyflame.YOUR-SUBDOMAIN.workers.dev
